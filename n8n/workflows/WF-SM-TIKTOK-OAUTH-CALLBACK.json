                  {
                      "parameters":  {
                                         "jsCode":  "const q = $json.query || {};\nconst auth_code = q.auth_code || q.code;\nconst state = q.state;\nif (!auth_code) throw new Error(\u0027TIKTOK_OAUTH_CODE_MISSING\u0027);\nif (!state) throw new Error(\u0027TIKTOK_OAUTH_STATE_MISSING\u0027);\nreturn [{ json: { auth_code, state } }];"
                                     },
                      "id":  "callback-normalize",
                      "name":  "02 - Normalize Callback",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       480,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "url":  "={{ $env.SUPABASE_URL + \u0027/rest/v1/oauth_sessions?select=id,platform,state,status,expires_at\u0026platform=eq.tiktok\u0026state=eq.\u0027 + encodeURIComponent($json.state) }}",
                                         "sendHeaders":  true,
                                         "headerParameters":  {
                                                                  "parameters":  [
                                                                                     {
                                                                                         "name":  "apikey",
                                                                                         "value":  "={{ $env.SUPABASE_SERVICE_KEY }}"
                                                                                     }
                                                                                 ]
                                                              },
                                         "options":  {

                                                     }
                                     },
                      "id":  "callback-load",
                      "name":  "03 - Load OAuth Session",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       700,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const callback = $(\u002702 - Normalize Callback\u0027).first().json;\nconst sessions = $input.first().json;\nconst session = Array.isArray(sessions) ? sessions[0] : sessions;\nif (!session?.id) throw new Error(\u0027TIKTOK_OAUTH_STATE_INVALID\u0027);\nif (session.status !== \u0027pending\u0027) throw new Error(\u0027TIKTOK_OAUTH_STATE_ALREADY_USED\u0027);\nif (new Date(session.expires_at).getTime() \u003c= Date.now()) throw new Error(\u0027TIKTOK_OAUTH_STATE_EXPIRED\u0027);\nreturn [{ json: { ...callback, session_id: session.id } }];"
                                     },
                      "id":  "callback-validate",
                      "name":  "04 - Validate OAuth Session",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       920,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "method":  "POST",
                                         "url":  "https://business-api.tiktok.com/open_api/v1.3/tt_user/oauth2/token/",
                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "={{ { client_id: $env.TIKTOK_CLIENT_ID, client_secret: $env.TIKTOK_CLIENT_SECRET, grant_type: \u0027authorization_code\u0027, auth_code: $json.auth_code, redirect_uri: $env.TIKTOK_REDIRECT_URI } }}",
                                         "options":  {

                                                     }
                                     },
                      "id":  "callback-exchange",
                      "name":  "05 - Exchange Auth Code",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       1140,
                                       300
                                   ],
                      "retryOnFail":  true,
                      "maxTries":  3,
                      "waitBetweenTries":  60000
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const response = $json;\nconst data = response.data || response;\nif (Number(response.code ?? 0) !== 0) throw new Error(\u0027TIKTOK_OAUTH_EXCHANGE_FAILED\u0027);\nif (!data.access_token || !data.refresh_token) throw new Error(\u0027TIKTOK_TOKEN_RESPONSE_INVALID\u0027);\nconst now = Date.now();\nreturn [{ json: { platform: \u0027tiktok\u0027, account_id: data.open_id || null, access_token: data.access_token, refresh_token: data.refresh_token, access_token_expires_at: new Date(now + Number(data.expires_in || 0) * 1000).toISOString(), refresh_token_expires_at: new Date(now + Number(data.refresh_token_expires_in || 0) * 1000).toISOString(), token_type: data.token_type || null, scopes: Array.isArray(data.scope) ? data.scope.join(\u0027,\u0027) : (data.scope || null), status: \u0027connected\u0027, last_refresh_at: new Date(now).toISOString(), session_id: $(\u002704 - Validate OAuth Session\u0027).first().json.session_id } }];"
                                     },
